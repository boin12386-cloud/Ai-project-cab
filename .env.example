# Server-only secret. Never put this in public/ or frontend JavaScript.
OPENAI_API_KEY=
# Choose a model enabled for your API account.
OPENAI_MODEL=gpt-6-astra
AI_RATE_LIMIT_PER_MINUTE=10

# Supabase project settings. The URL and anon/publishable key are public client config;
# database Row Level Security must be enabled. Never use a service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Hosting platform supplies PORT automatically in most cases.
PORT=3000
